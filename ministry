<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ministry of Important Decisions</title>
  <link rel="stylesheet" href="* {
  box-sizing: border-box;
  font-family: "Segoe UI", system-ui, sans-serif;
}

body {
  margin: 0;
  background: linear-gradient(180deg, #ffd6cc, #ffefe9);
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page {
  padding: 20px;
  width: 100%;
}

.card {
  background: #fff7ef;
  max-width: 520px;
  margin: auto;
  border-radius: 24px;
  padding: 32px 28px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  text-align: center;
}

.header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 20px;
}

.logo {
  font-size: 1.5rem;
}

.title {
  font-weight: 600;
  color: #444;
}

.content h1 {
  margin: 10px 0;
  color: #333;
}

.subtitle {
  color: #666;
  font-size: 0.95rem;
  margin-bottom: 30px;
}

.primary-btn {
  background: #ff8a5c;
  color: white;
  border: none;
  padding: 14px 26px;
  border-radius: 999px;
  font-size: 1rem;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(255,138,92,0.4);
}

.status-text {
  margin-top: 20px;
  font-size: 0.9rem;
  color: #888;
}

.footer {
  margin-top: 30px;
  font-size: 0.8rem;
  color: #999;
}
">
</head>
<body>

  <div class="page">
    <div class="card">

      <header class="header">
        <span class="logo">🏛️</span>
        <span class="title">Ministry of Important Decisions</span>
      </header>

      <main class="content">
        <h1>Hello & Welcome</h1>
        <p class="subtitle">
          This portal handles small but important emotional requests.<br>
          Proceed only if you’re feeling a little curious.
        </p>

        <button id="callBtn" class="primary-btn">
          Submit Call Request
        </button>

        <p id="status" class="status-text">
          No active requests.
        </p>
      </main>

      <footer class="footer">
        No urgency. No pressure. Just presence.
      </footer>

    </div>
  </div>

  <script src="const callBtn = document.getElementById("callBtn");
const statusText = document.getElementById("status");

function sendNotification() {
  if (Notification.permission === "granted") {
    new Notification("📞 MID Update", {
      body: "Someone would like to call you 👀",
    });
  }
}

callBtn.addEventListener("click", async () => {
  if (!("Notification" in window)) {
    alert("Notifications are not supported on this browser.");
    return;
  }

  if (Notification.permission === "default") {
    await Notification.requestPermission();
  }

  if (Notification.permission === "granted") {
    sendNotification();
    statusText.textContent =
      "Call request submitted
"></script> 
<script src="script.js"></script>
</body>
</html>
